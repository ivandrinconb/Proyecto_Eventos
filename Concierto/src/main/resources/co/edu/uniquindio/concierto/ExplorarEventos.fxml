<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="647.0" prefWidth="699.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.concierto.viewController.ExplorarEventosViewController">
    <children>
        <SplitPane dividerPositions="0.55" layoutX="23.0" layoutY="25.0"
                   orientation="VERTICAL" prefHeight="548.0" prefWidth="660.0">
            <items>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="290.0" prefWidth="660.0">
                    <children>
                        <Label layoutX="14.0" layoutY="4.0" text="Explorar Eventos">
                            <font><Font name="Times New Roman Bold" size="17.0"/></font>
                        </Label>
                        <Separator layoutX="14.0" layoutY="29.0" prefHeight="0.0" prefWidth="634.0"/>

                        <Label layoutX="27.0" layoutY="55.0" text="Ciudad:">
                            <font><Font name="Times New Roman" size="14.0"/></font>
                        </Label>
                        <TextField fx:id="txtCiudad" layoutX="183.0" layoutY="50.0" prefHeight="26.0" prefWidth="200.0"/>

                        <Label layoutX="27.0" layoutY="100.0" text="Categoría:">
                            <font><Font name="Times New Roman" size="14.0"/></font>
                        </Label>
                        <ComboBox fx:id="cbCategoria" layoutX="183.0" layoutY="95.0" prefHeight="26.0" prefWidth="200.0"/>

                        <Label layoutX="27.0" layoutY="145.0" text="Precio máximo:">
                            <font><Font name="Times New Roman" size="14.0"/></font>
                        </Label>
                        <TextField fx:id="txtPrecioMax" layoutX="183.0" layoutY="140.0" prefHeight="26.0" prefWidth="200.0"/>

                        <Label layoutX="27.0" layoutY="190.0" text="Fecha:">
                            <font><Font name="Times New Roman" size="14.0"/></font>
                        </Label>
                        <TextField fx:id="txtFecha" layoutX="183.0" layoutY="185.0" prefHeight="26.0" prefWidth="200.0"/>

                        <Button fx:id="btnFiltrar" layoutX="420.0" layoutY="90.0"
                                mnemonicParsing="false" onAction="#OnActionFiltrar" text="Filtrar">
                            <font><Font name="Times New Roman Bold" size="14.0"/></font>
                        </Button>
                        <Button fx:id="btnLimpiar" layoutX="420.0" layoutY="135.0"
                                mnemonicParsing="false" onAction="#OnActionLimpiar" text="Limpiar filtros">
                            <font><Font name="Times New Roman Bold" size="14.0"/></font>
                        </Button>
                        <Button fx:id="btnVerDetalle" layoutX="420.0" layoutY="185.0"
                                mnemonicParsing="false" onAction="#OnActionVerDetalle" text="Ver detalle">
                            <font><Font name="Times New Roman Bold" size="14.0"/></font>
                        </Button>
                        <Button fx:id="btnVolver" layoutX="420.0" layoutY="230.0"
                                mnemonicParsing="false" onAction="#OnActionVolver" text="Volver">
                            <font><Font name="Times New Roman Bold" size="14.0"/></font>
                        </Button>
                    </children>
                </AnchorPane>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="230.0" prefWidth="660.0">
                    <children>
                        <TableView fx:id="tableEventos" layoutX="14.0" layoutY="10.0"
                                   prefHeight="210.0" prefWidth="634.0">
                            <columns>
                                <TableColumn fx:id="tcNombreEvento" prefWidth="160.0" text="Nombre"/>
                                <TableColumn fx:id="tcCategoriaEvento" prefWidth="120.0" text="Categoría"/>
                                <TableColumn fx:id="tcCiudadEvento" prefWidth="100.0" text="Ciudad"/>
                                <TableColumn fx:id="tcFechaEvento" prefWidth="120.0" text="Fecha"/>
                                <TableColumn fx:id="tcPrecioEvento" prefWidth="100.0" text="Precio base"/>
                                <TableColumn fx:id="tcEstadoEvento" prefWidth="100.0" text="Estado"/>
                            </columns>
                        </TableView>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>