<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="647.0" prefWidth="699.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.concierto.viewController.PerfilUsuarioViewController">
    <children>
        <SplitPane dividerPositions="0.55" layoutX="23.0" layoutY="25.0"
                   orientation="VERTICAL" prefHeight="548.0" prefWidth="660.0">
            <items>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="295.0" prefWidth="660.0">
                    <children>
                        <Label layoutX="14.0" layoutY="4.0" text="Mi Perfil">
                            <font><Font name="Times New Roman Bold" size="17.0"/></font>
                        </Label>
                        <Separator layoutX="14.0" layoutY="29.0" prefHeight="0.0" prefWidth="634.0"/>
                        <Label layoutX="27.0" layoutY="55.0" text="Nombre:">
                            <font><Font name="Times New Roman" size="14.0"/></font>
                        </Label>
                        <TextField fx:id="txtNombre" layoutX="183.0" layoutY="50.0" prefHeight="26.0" prefWidth="242.0"/>
                        <Label layoutX="27.0" layoutY="100.0" text="Correo electronico:">
                            <font><Font name="Times New Roman" size="14.0"/></font>
                        </Label>
                        <TextField fx:id="txtCorreo" layoutX="183.0" layoutY="95.0" prefHeight="26.0" prefWidth="242.0"/>
                        <Label layoutX="27.0" layoutY="145.0" text="Telefono:">
                            <font><Font name="Times New Roman" size="14.0"/></font>
                        </Label>
                        <TextField fx:id="txtTelefono" layoutX="183.0" layoutY="140.0" prefHeight="26.0" prefWidth="242.0"/>
                        <Separator layoutX="14.0" layoutY="185.0" prefHeight="0.0" prefWidth="634.0"/>
                        <Label layoutX="14.0" layoutY="200.0" text="Agregar metodo de pago:">
                            <font><Font name="Times New Roman Bold" size="14.0"/></font>
                        </Label>
                        <Label layoutX="27.0" layoutY="230.0" text="Tipo:">
                            <font><Font name="Times New Roman" size="14.0"/></font>
                        </Label>
                        <ComboBox fx:id="cbTipoMetodo" layoutX="183.0" layoutY="225.0" prefHeight="26.0" prefWidth="180.0"/>
                        <Label layoutX="27.0" layoutY="270.0" text="Numero:">
                            <font><Font name="Times New Roman" size="14.0"/></font>
                        </Label>
                        <TextField fx:id="txtNumeroMetodo" layoutX="183.0" layoutY="265.0" prefHeight="26.0" prefWidth="180.0"/>
                        <Button fx:id="btnActualizar" layoutX="460.0" layoutY="50.0"
                                mnemonicParsing="false" onAction="#OnActionActualizar" text="Actualizar perfil">
                            <font><Font name="Times New Roman Bold" size="14.0"/></font>
                        </Button>
                        <Button fx:id="btnAgregarMetodo" layoutX="460.0" layoutY="225.0"
                                mnemonicParsing="false" onAction="#OnActionAgregarMetodo" text="Agregar metodo">
                            <font><Font name="Times New Roman Bold" size="14.0"/></font>
                        </Button>
                        <Button fx:id="btnEliminarMetodo" layoutX="460.0" layoutY="270.0"
                                mnemonicParsing="false" onAction="#OnActionEliminarMetodo" text="Eliminar metodo">
                            <font><Font name="Times New Roman Bold" size="14.0"/></font>
                        </Button>
                        <Button fx:id="btnVolver" layoutX="460.0" layoutY="100.0"
                                mnemonicParsing="false" onAction="#OnActionVolver" text="Volver">
                            <font><Font name="Times New Roman Bold" size="14.0"/></font>
                        </Button>
                    </children>
                </AnchorPane>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="220.0" prefWidth="660.0">
                    <children>
                        <Label layoutX="14.0" layoutY="5.0" text="Mis metodos de pago:">
                            <font><Font name="Times New Roman Bold" size="14.0"/></font>
                        </Label>
                        <TableView fx:id="tableMetodos" layoutX="14.0" layoutY="25.0" prefHeight="185.0" prefWidth="634.0">
                            <columns>
                                <TableColumn fx:id="tcIdMetodo" prefWidth="120.0" text="ID"/>
                                <TableColumn fx:id="tcTipoMetodo" prefWidth="180.0" text="Tipo"/>
                                <TableColumn fx:id="tcNumeroMetodo" prefWidth="334.0" text="Numero"/>
                            </columns>
                        </TableView>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>
