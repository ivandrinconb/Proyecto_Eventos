<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="647.0" prefWidth="699.0"
            style="-fx-background-color: #1a1a2e;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.concierto.viewController.MenuUsuarioViewController">
    <children>

        <!-- Header -->
        <VBox alignment="CENTER" layoutX="0.0" layoutY="0.0" prefWidth="699.0" prefHeight="110.0"
              style="-fx-background-color: linear-gradient(to right, #1565C0, #1976D2);">
            <children>
                <Label text="Menú Usuario"
                       style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;"/>
                <Label fx:id="lblBienvenida" text="¡Bienvenido! ¿Qué deseas hacer hoy?"
                       style="-fx-text-fill: #BBDEFB; -fx-font-size: 14px;"/>
            </children>
        </VBox>

        <!-- Grid de botones -->
        <GridPane layoutX="50.0" layoutY="140.0" prefWidth="600.0" prefHeight="380.0"
                  hgap="20.0" vgap="20.0">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS" percentHeight="50"/>
                <RowConstraints vgrow="ALWAYS" percentHeight="50"/>
            </rowConstraints>

            <!-- Fila 1 -->

            <!-- Ver Eventos -->
            <VBox alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="0"
                  style="-fx-background-color: #1565C0; -fx-background-radius: 12; -fx-cursor: hand;"
                  onMouseClicked="#onVerEventos" prefHeight="155.0">
                <padding><Insets top="20" bottom="20" left="10" right="10"/></padding>
                <children>
                    <Label text="📅" style="-fx-font-size: 42px;"/>
                    <Label text="Ver Eventos"
                           style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                </children>
            </VBox>

            <!-- Comprar Entradas -->
            <VBox alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="0"
                  style="-fx-background-color: #2E7D32; -fx-background-radius: 12; -fx-cursor: hand;"
                  onMouseClicked="#onComprarEntradas" prefHeight="155.0">
                <padding><Insets top="20" bottom="20" left="10" right="10"/></padding>
                <children>
                    <Label text="🎟️" style="-fx-font-size: 42px;"/>
                    <Label text="Comprar Entradas"
                           style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                </children>
            </VBox>

            <!-- Mis Compras -->
            <VBox alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="0"
                  style="-fx-background-color: #E65100; -fx-background-radius: 12; -fx-cursor: hand;"
                  onMouseClicked="#onMisCompras" prefHeight="155.0">
                <padding><Insets top="20" bottom="20" left="10" right="10"/></padding>
                <children>
                    <Label text="🧾" style="-fx-font-size: 42px;"/>
                    <Label text="Mis Compras"
                           style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                </children>
            </VBox>

            <!-- Fila 2 -->

            <!-- Servicios Adicionales -->
            <VBox alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="1"
                  style="-fx-background-color: #455A64; -fx-background-radius: 12; -fx-cursor: hand;"
                  onMouseClicked="#onServiciosAdicionales" prefHeight="155.0">
                <padding><Insets top="20" bottom="20" left="10" right="10"/></padding>
                <children>
                    <Label text="🚗" style="-fx-font-size: 42px;"/>
                    <Label text="Servicios Adicionales"
                           style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                </children>
            </VBox>

            <!-- Reportar Incidencia -->
            <VBox alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1"
                  style="-fx-background-color: #C62828; -fx-background-radius: 12; -fx-cursor: hand;"
                  onMouseClicked="#onReportarIncidencia" prefHeight="155.0">
                <padding><Insets top="20" bottom="20" left="10" right="10"/></padding>
                <children>
                    <Label text="⚠️" style="-fx-font-size: 42px;"/>
                    <Label text="Reportar Incidencia"
                           style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                </children>
            </VBox>

            <!-- Mi Perfil -->
            <VBox alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="1"
                  style="-fx-background-color: #4527A0; -fx-background-radius: 12; -fx-cursor: hand;"
                  onMouseClicked="#onMiPerfil" prefHeight="155.0">
                <padding><Insets top="20" bottom="20" left="10" right="10"/></padding>
                <children>
                    <Label text="👤" style="-fx-font-size: 42px;"/>
                    <Label text="Mi Perfil"
                           style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                </children>
            </VBox>

        </GridPane>

        <!-- Botón cerrar sesión abajo -->
        <Button text="Cerrar sesión" layoutX="290.0" layoutY="565.0"
                onAction="#onCerrarSesion"
                style="-fx-background-color: transparent; -fx-text-fill: #90CAF9; -fx-font-size: 13px; -fx-underline: true; -fx-cursor: hand;"/>

    </children>
</AnchorPane>
