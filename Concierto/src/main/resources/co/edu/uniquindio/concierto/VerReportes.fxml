      <Button fx:id="btnExportarPDF" contentDisplay="TOP" layoutX="400.0" layoutY="390.0" mnemonicParsing="false" onAction="#OnActionExportarPDF" style="-fx-background-color: #FF9800; -fx-text-fill: White;" text="Exportar PDF">
         <graphic>
