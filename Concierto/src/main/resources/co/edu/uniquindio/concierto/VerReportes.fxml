<AnchorPane prefHeight="522.0" prefWidth="669.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.concierto.viewController.VerReportesViewController">
