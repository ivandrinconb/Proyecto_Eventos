<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="647.0" prefWidth="699.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.concierto.viewController.HistorialComprasViewController">
    <children>
        <SplitPane dividerPositions="0.38" layoutX="23.0" layoutY="25.0"
                   orientation="VERTICAL" prefHeight="548.0" prefWidth="660.0">
            <items>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="200.0" prefWidth="660.0">
                    <children>
                        <Label layoutX="14.0" layoutY="4.0" text="Historial de Compras">
                            <font><Font name="Times New Roman Bold" size="17.0"/></font>
                        </Label>
                        <Separator layoutX="14.0" layoutY="29.0" prefHeight="0.0" prefWidth="634.0"/>
                        <Label layoutX="27.0" layoutY="55.0" text="Filtrar por estado:">
                            <font><Font name="Times New Roman" size="14.0"/></font>
                        </Label>
                        <ComboBox fx:id="cbEstado" layoutX="183.0" layoutY="50.0" prefHeight="26.0" prefWidth="180.0"/>
                        <Label layoutX="27.0" layoutY="100.0" text="Filtrar por evento:">
                            <font><Font name="Times New Roman" size="14.0"/></font>
                        </Label>
                        <TextField fx:id="txtFiltroEvento" layoutX="183.0" layoutY="95.0" prefHeight="26.0" prefWidth="180.0"/>
                        <Label layoutX="27.0" layoutY="145.0" text="Filtrar por fecha:">
                            <font><Font name="Times New Roman" size="14.0"/></font>
                        </Label>
                        <TextField fx:id="txtFiltroFecha" layoutX="183.0" layoutY="140.0" prefHeight="26.0" prefWidth="180.0"/>
                        <Button fx:id="btnFiltrar" layoutX="400.0" layoutY="50.0"
                                mnemonicParsing="false" onAction="#OnActionFiltrar" text="Filtrar">
                            <font><Font name="Times New Roman Bold" size="14.0"/></font>
                        </Button>
                        <Button fx:id="btnCancelarCompra" layoutX="400.0" layoutY="100.0"
                                mnemonicParsing="false" onAction="#OnActionCancelarCompra" text="Cancelar compra">
                            <font><Font name="Times New Roman Bold" size="14.0"/></font>
                        </Button>
                        <Button fx:id="btnVolver" layoutX="400.0" layoutY="150.0"
                                mnemonicParsing="false" onAction="#OnActionVolver" text="Volver">
                            <font><Font name="Times New Roman Bold" size="14.0"/></font>
                        </Button>
                    </children>
                </AnchorPane>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="330.0" prefWidth="660.0">
                    <children>
                        <TableView fx:id="tableCompras" layoutX="14.0" layoutY="10.0" prefHeight="300.0" prefWidth="634.0">
                            <columns>
                                <TableColumn fx:id="tcIdCompra" prefWidth="100.0" text="ID Compra"/>
                                <TableColumn fx:id="tcEventoCompra" prefWidth="150.0" text="Evento"/>
                                <TableColumn fx:id="tcFechaCompra" prefWidth="110.0" text="Fecha"/>
                                <TableColumn fx:id="tcTotalCompra" prefWidth="100.0" text="Total"/>
                                <TableColumn fx:id="tcEstadoCompra" prefWidth="174.0" text="Estado"/>
                            </columns>
                        </TableView>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>

